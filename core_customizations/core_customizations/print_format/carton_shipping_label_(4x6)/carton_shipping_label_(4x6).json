{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-11-02 10:22:26.089362",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Packing Slip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap');\n\n@page {\n    size: 4in 6in;\n    margin: 4mm 5mm;\n}\n\n.print-format,\n.print-format *,\n.shipping-label-container,\n.shipping-label-container * {\n    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif !important;\n    box-sizing: border-box !important;\n}\n\n.print-format {\n    padding: 0 !important;\n    margin: 0 auto !important;\n    color: #000 !important;\n    background: #fff !important;\n}\n\n@media screen {\n    .print-format {\n        width: 3.75in !important;\n        min-height: 5.75in !important;\n        max-width: 3.75in !important;\n        margin: 15px auto !important;\n        background: #fff !important;\n        box-shadow: 0 0 10px rgba(0,0,0,0.15) !important;\n    }\n}\n\n@media print {\n    html, body {\n        width: 4in !important;\n        height: 6in !important;\n        margin: 0 !important;\n        padding: 0 !important;\n        background: #fff !important;\n    }\n    .print-format {\n        width: 100% !important;\n        max-width: 100% !important;\n        max-height: 5.7in !important;\n        margin: 0 !important;\n        padding: 0 !important;\n        page-break-after: avoid !important;\n        page-break-inside: avoid !important;\n    }\n}\n\n.shipping-label-container {\n    width: 100%;\n    max-width: 100%;\n    border: 2px solid #000;\n    margin: 0 auto;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    font-size: 8.5pt;\n    line-height: 1.25;\n    background: #fff;\n    page-break-inside: avoid !important;\n    box-sizing: border-box !important;\n}\n\n/* 1. Header Section */\n.label-header-section {\n    display: flex;\n    border-bottom: 2px solid #000;\n    width: 100%;\n}\n\n.header-left {\n    width: 58%;\n    padding: 5px 8px;\n    border-right: 2px solid #000;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n}\n\n.header-right {\n    width: 42%;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    background-color: #fff;\n}\n\n.invoice-header-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    margin-bottom: 2px;\n}\n\n.invoice-number-text {\n    font-size: 11pt;\n    font-weight: 900;\n    color: #000;\n    letter-spacing: -0.2px;\n    line-height: 1.1;\n}\n\n.invoice-date-text {\n    font-size: 8pt;\n    font-weight: 700;\n    color: #333;\n}\n\n.barcode-wrapper {\n    margin: 3px 0 2px 0;\n    text-align: left;\n}\n\n.barcode-wrapper svg {\n    max-width: 100%;\n    height: 26px !important;\n    display: block;\n}\n\n.box-count-header {\n    background-color: #e9ecef;\n    color: #000;\n    font-size: 8pt;\n    font-weight: 800;\n    text-align: center;\n    padding: 3px 2px;\n    border-bottom: 1.5px solid #000;\n    text-transform: uppercase;\n    letter-spacing: 0.3px;\n}\n\n.box-count-body {\n    flex-grow: 1;\n    min-height: 56px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 4px;\n}\n\n.box-number-display {\n    font-size: 12pt;\n    font-weight: 900;\n    color: #000;\n    letter-spacing: 0.5px;\n    text-align: center;\n    line-height: 1.2;\n}\n\n/* Section Banners */\n.section-banner {\n    background-color: #e9ecef !important;\n    color: #000 !important;\n    border-bottom: 1.5px solid #000 !important;\n    padding: 3px 8px !important;\n    font-size: 8pt !important;\n    font-weight: 800 !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.4px !important;\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: center !important;\n}\n\n.delivery-badge {\n    font-size: 7pt;\n    font-weight: 800;\n    padding: 1.5px 6px;\n    border-radius: 2px;\n    text-transform: uppercase;\n    letter-spacing: 0.3px;\n}\n\n.badge-door {\n    background-color: #fff;\n    color: #000;\n    border: 1px solid #000;\n}\n\n.badge-godown {\n    background-color: #000;\n    color: #fff;\n    border: 1px solid #000;\n}\n\n/* 2. Consignee Section */\n.consignee-section {\n    padding: 6px 8px;\n    border-bottom: 1.5px solid #000;\n}\n\n.consignee-name {\n    font-size: 11pt;\n    font-weight: 900;\n    color: #000;\n    margin-bottom: 2px;\n    line-height: 1.15;\n}\n\n.address-text {\n    font-size: 8pt;\n    color: #000;\n    line-height: 1.25;\n    margin-bottom: 3px;\n}\n\n.godown-pickup-box {\n    border: 1.5px dashed #000;\n    background-color: #fdf2f2;\n    padding: 4px 6px;\n    margin-bottom: 4px;\n    border-radius: 2px;\n}\n\n/* 3. Shipping Provider Section */\n.shipping-provider-section {\n    border-bottom: 1.5px solid #000;\n}\n\n/* 4. Consignor Section */\n.consignor-section {\n    padding: 5px 8px;\n    background-color: #fafafa;\n}\n\n.consignor-title {\n    font-size: 9pt;\n    font-weight: 800;\n    color: #000;\n    margin-bottom: 1px;\n}\n</style>\n\n{% set dn_fields = [\"name\", \"posting_date\", \"customer\", \"customer_name\", \"address_display\", \"billing_address_gstin\", \"tax_id\", \"transporter\", \"custom_transporter_from_address_display\", \"custom_is_godown_delivery\", \"custom_transporter_to_address_display\", \"custom_total_boxes\", \"po_no\", \"company\", \"company_address_display\", \"company_gstin\"] %}\n{% set dn = frappe.db.get_value(\"Delivery Note\", doc.delivery_note, dn_fields, as_dict=True) if doc.delivery_note else None %}\n{% set total_boxes = (dn.custom_total_boxes if dn else None) or doc.to_case_no or 1 %}\n{% set is_godown = dn.custom_is_godown_delivery if dn else 0 %}\n{% set transporter = (dn.transporter) if dn else None %}\n{% set transporter_name = (frappe.db.get_value(\"Supplier\", transporter, \"supplier_name\") or transporter) if transporter else None %}\n{% set from_addr_display = dn.custom_transporter_from_address_display if dn else None %}\n{% set to_addr_display = dn.custom_transporter_to_address_display if dn else None %}\n\n<div class=\"shipping-label-container\">\n    <!-- 1. Header Section -->\n    <div class=\"label-header-section\">\n        <!-- Top-Left: PS Number, DN Reference, Date, Barcode -->\n        <div class=\"header-left\">\n            <!-- Dual ID + Barcode blocks side-by-side -->\n            <div style=\"display: flex; gap: 5px; align-items: flex-start;\">\n                <!-- Left: Packing Slip -->\n                <div style=\"flex: 1; text-align: center; border-right: 1.5px dashed #bbb; padding-right: 5px;\">\n                    <div style=\"font-size: 7pt; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 1px;\">PACKING SLIP #</div>\n                    <div style=\"font-size: 9pt; font-weight: 900; color: #000; margin-bottom: 1px; line-height: 1.15; word-break: break-all;\">{{ doc.name }}</div>\n                    <div class=\"barcode-wrapper\">\n                        {% if get_code128_svg is defined %}\n                            {{ get_code128_svg(doc.name, 20, 1.0) }}\n                        {% elif get_barcode is defined %}\n                            {{ get_barcode(doc.name) }}\n                        {% else %}\n                            <div style=\"border: 1px solid #000; padding: 1px 4px; font-family: monospace; font-size: 7pt; font-weight: bold; display: inline-block; background: #fafafa;\">* {{ doc.name }} *</div>\n                        {% endif %}\n                    </div>\n                </div>\n                {% if doc.delivery_note %}\n                <!-- Right: Delivery Note -->\n                <div style=\"flex: 1; text-align: center; padding-left: 5px;\">\n                    <div style=\"font-size: 7pt; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 1px;\">DELIVERY NOTE #</div>\n                    <div style=\"font-size: 9pt; font-weight: 900; color: #2b6cb0; margin-bottom: 1px; line-height: 1.15; word-break: break-all;\">{{ doc.delivery_note }}</div>\n                    <div class=\"barcode-wrapper\">\n                        {% if get_code128_svg is defined %}\n                            {{ get_code128_svg(doc.delivery_note, 20, 1.0) }}\n                        {% elif get_barcode is defined %}\n                            {{ get_barcode(doc.delivery_note) }}\n                        {% else %}\n                            <div style=\"border: 1px solid #000; padding: 1px 4px; font-family: monospace; font-size: 7pt; font-weight: bold; display: inline-block; background: #fafafa;\">* {{ doc.delivery_note }} *</div>\n                        {% endif %}\n                    </div>\n                </div>\n                {% endif %}\n            </div>\n            <!-- PS Date -->\n            <div style=\"font-size: 7pt; color: #555; margin-top: 2px; text-align: left;\">\n                <b>Date:</b> {{ doc.get_formatted('posting_date') or doc.get_formatted('creation') }}\n            </div>\n        </div>\n        \n        <!-- Top-Right: Auto-filled Box Number / Total Box Count Area -->\n        <div class=\"header-right\">\n            <div class=\"box-count-header\">BOX NUMBER / TOTAL</div>\n            <div class=\"box-count-body\">\n                <div class=\"box-number-display\">\n                    BOX [ &nbsp;<b>{{ doc.from_case_no }}</b>&nbsp; ]<br>\n                    <span style=\"font-size: 8.5pt; font-weight: 700; color: #444;\">OF</span> [ &nbsp;<b>{{ total_boxes }}</b>&nbsp; ]\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 2. Consignee (Customer) Section -->\n    <div class=\"section-banner\">\n        <span>CONSIGNEE (CUSTOMER)</span>\n        {% if is_godown %}\n            <span class=\"delivery-badge badge-godown\">\u26a0 GODOWN PICKUP</span>\n        {% else %}\n            <span class=\"delivery-badge badge-door\">DOOR DELIVERY</span>\n        {% endif %}\n    </div>\n    \n    <div class=\"consignee-section\">\n        {% if is_godown and to_addr_display %}\n            <!-- Godown Pickup Destination Address -->\n            <div class=\"godown-pickup-box\">\n                <div style=\"font-size: 7.5pt; font-weight: 800; color: #b71c1c; text-transform: uppercase; margin-bottom: 1px;\">\n                    \ud83d\udccd PICKUP ADDRESS (TRANSPORTER GODOWN):\n                </div>\n                <div style=\"font-size: 9pt; font-weight: bold; color: #000; line-height: 1.25;\">\n                    {{ to_addr_display | replace('\\n', ', ') | replace('<br>', ', ') }}\n                </div>\n            </div>\n            \n            <div>\n                <div class=\"consignee-name\" style=\"font-size: 10pt;\">{{ (dn.customer_name if dn else '') or 'Customer' }}</div>\n                <div class=\"address-text\" style=\"font-size: 8pt; margin-bottom: 2px;\">\n                    <b>Consignee Reg. Address:</b> {{ (dn.address_display | replace('<br>', ', ')) if (dn and dn.address_display) else '' }}\n                </div>\n                <div>\n                    {% if dn and dn.billing_address_gstin %}\n                        <span style=\"font-size: 8pt; margin-right: 4px;\"><b>GSTIN:</b> {{ dn.billing_address_gstin }}</span>\n                    {% elif dn and dn.tax_id %}\n                        <span style=\"font-size: 8pt; margin-right: 4px;\"><b>GSTIN:</b> {{ dn.tax_id }}</span>\n                    {% endif %}\n                </div>\n            </div>\n        {% else %}\n            <!-- Standard Consignee Delivery Address -->\n            <div class=\"consignee-name\">{{ (dn.customer_name if dn else '') or 'Customer' }}</div>\n            <div class=\"address-text\">\n                <b>Delivery Address:</b><br>\n                {% if dn and dn.address_display %}\n                    {{ dn.address_display | replace('<br>', ', ') }}\n                {% else %}\n                    <i>No delivery address specified</i>\n                {% endif %}\n            </div>\n            \n            <div>\n                {% if dn and dn.billing_address_gstin %}\n                    <span style=\"font-size: 8pt; margin-right: 4px;\"><b>GSTIN:</b> {{ dn.billing_address_gstin }}</span>\n                {% elif dn and dn.tax_id %}\n                    <span style=\"font-size: 8pt; margin-right: 4px;\"><b>GSTIN:</b> {{ dn.tax_id }}</span>\n                {% endif %}\n            </div>\n        {% endif %}\n    </div>\n\n    <!-- 3. Shipping Provider & Dedicated Reference / Routing Code Section -->\n    <div class=\"section-banner\">\n        <span>SHIPPING & ROUTING DETAILS</span>\n        <span style=\"font-size: 7.5pt; font-weight: 800; color: #333;\">REF / ROUTING CODE</span>\n    </div>\n    <div class=\"shipping-provider-section\">\n        <table style=\"width: 100%; border-collapse: collapse; margin: 0;\">\n            <tr>\n                <td style=\"width: 58%; padding: 6px 8px; vertical-align: top; font-size: 8pt; line-height: 1.25;\">\n                    {% if transporter or from_addr_display %}\n                        <b>Transporter:</b> {{ transporter_name or 'N/A' }}<br>\n                        {% if from_addr_display %}\n                            <b>Booking / Origin Hub:</b><br>\n                            {{ from_addr_display | replace('\\n', ', ') | replace('<br>', ', ') }}\n                        {% endif %}\n                    {% else %}\n                        <b>Shipping Mode:</b> Direct Delivery / Door Delivery<br>\n                    {% endif %}\n                    {% if dn and dn.po_no %}\n                        <b>Customer PO Ref:</b> {{ dn.po_no }}\n                    {% endif %}\n                </td>\n                <td style=\"width: 42%; border-left: 1.5px solid #000; padding: 4px 6px; vertical-align: middle; background-color: #fff;\">\n                    <div style=\"border: 1.5px dashed #777; background: #fff; border-radius: 2px; height: 100%; min-height: 60px;\">\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- 4. Consignor (Sender Our Company) -->\n    <div class=\"section-banner\">\n        <span>CONSIGNOR (SENDER)</span>\n    </div>\n    <div class=\"consignor-section\">\n        <div class=\"consignor-title\">{{ dn.company if dn else 'Our Company' }}</div>\n        <div style=\"line-height: 1.3; font-size: 8pt;\">\n            {% if dn and dn.company_address_display %}\n                {{ dn.company_address_display | replace('<br>', ', ') }}<br>\n            {% endif %}\n            <b>GSTIN:</b> {{ (dn.company_gstin) if dn else '' }}\n        </div>\n    </div>\n</div>",
